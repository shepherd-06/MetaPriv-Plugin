{
  "manifest_version": 2,
  "name": "MetaPriv 🧠",
  "version": "1.0",
  "description": "Vrooooom Vrooooom",
  "icons": {
    "48": "icon.png"
  },
  "permissions": ["tabs", "storage"],
  "host_permissions": ["http://127.0.0.1:5000/"],
  "content_scripts": [
    {
      "matches": ["*://www.facebook.com/*"],
      "js": ["content.js"]
    }
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "browser_action": {
    "default_icon": "icon.png",
    "default_popup": "popup.html",
    "default_title": "MetaPriv 🧠"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "not-sure@vroom-vroom.com"
    }
  },
  "web_accessible_resources": ["utils/storage.js"]
}
