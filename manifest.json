{
    "manifest_version": 2,
    "name": "MetaPriv 🧠",
    "version": "1.0",
    "description": "Version 1 Alpha: Basic template that activates only on Facebook.com.",
    "icons": {
        "48": "icon.png"
    },
    "permissions": [
        "tabs",
        "https://www.facebook.com/"
    ],
    "content_scripts": [
        {
            "matches": [
                "*://www.facebook.com/*"
            ],
            "js": [
                "content.js"
            ]
        }
    ],
    "background": {
        "scripts": [
            "background.js"
        ]
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "not-sure@vroom-vroom.com"
        }
    }
}